# Easiest: run  npm run setup:env  and it writes this file for you (with a random SESSION_SECRET).
# Or copy this file to .env and fill it in by hand.

DATABASE_URL=postgresql://DB_USER:YOUR_PASSWORD@127.0.0.1:5432/DB_NAME
PORT=8080

# Sign-in. ADMIN_PASSWORD creates the first administrator (ADMIN_EMAIL, default admin@ipi.ph)
# when there are no users yet; that account must choose a new password at its first sign-in.
# SESSION_SECRET signs the session cookie: use a long random string
# (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
ADMIN_PASSWORD=
ADMIN_EMAIL=
SESSION_SECRET=
